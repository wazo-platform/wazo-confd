[Unit]
Description=wazo-confd HTTP worker on port %i
After=network.target postgresql.service wazo-confd.service
PartOf=wazo-confd.service
StartLimitBurst=15
StartLimitIntervalSec=150

[Service]
ExecStart=/usr/bin/wazo-confd --role api --listen-port %i
ExecStartPost=/usr/bin/wazo-confd-wait --port %i
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
SyslogIdentifier=wazo-confd-worker@%i

[Install]
WantedBy=wazo-confd.service
