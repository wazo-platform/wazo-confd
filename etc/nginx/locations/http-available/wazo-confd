# No /guests and /wizard locations, unlike https: they only exist there to
# rate limit per client IP, and every internal client shares 127.0.0.1.
location ^~ /api/confd/1.1/users/import {
    proxy_pass http://wazo-confd/1.1/users/import;
    proxy_read_timeout 1800s;  # 30min
    include /etc/nginx/wazo-confd-shared.conf;
}

location ^~ /api/confd/ {
    proxy_pass http://wazo-confd/;
    # Mostly used for /ha but can be useful for other
    # endpoints on slow host (e.i. /devices)
    proxy_read_timeout 180s;
    include /etc/nginx/wazo-confd-shared.conf;
}
